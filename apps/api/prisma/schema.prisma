datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  RESIDENT
  GUARD
  ADMIN
}

enum ParcelStatus {
  LOGGED
  SCHEDULED
  HANDED_OVER
  UNCLAIMED
  RETURNED
}

enum HandoverMode {
  PICKUP
  DOOR
}

enum NotificationChannel {
  PUSH
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Society {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flats   Flat[]
  users   User[]
  parcels Parcel[]

  @@map("societies")
}

model Flat {
  id        String   @id @default(uuid())
  societyId String
  society   Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  tower     String
  number    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  parcels Parcel[]

  @@unique([societyId, tower, number])
  @@index([societyId])
  @@map("flats")
}

model User {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  role      UserRole  @default(RESIDENT)
  societyId String
  society   Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flatId    String?
  flat      Flat?     @relation(fields: [flatId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  loggedParcels   Parcel[]       @relation("LoggedParcels")
  completedHandovers Handover[]  @relation("CompletedHandovers")
  notifications   Notification[]

  @@index([societyId])
  @@index([flatId])
  @@index([phone])
  @@map("users")
}

model Parcel {
  id         String       @id @default(uuid())
  societyId  String
  society    Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flatId     String
  flat       Flat         @relation(fields: [flatId], references: [id], onDelete: Cascade)
  courier    String
  photoUrl   String?
  status     ParcelStatus @default(LOGGED)
  loggedById String
  loggedBy   User         @relation("LoggedParcels", fields: [loggedById], references: [id])
  loggedAt   DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  handover      Handover?
  notifications Notification[]

  @@index([societyId])
  @@index([flatId])
  @@index([status])
  @@index([loggedAt])
  @@map("parcels")
}

model Handover {
  id            String       @id @default(uuid())
  parcelId      String       @unique
  parcel        Parcel       @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  mode          HandoverMode @default(PICKUP)
  slotStart     DateTime
  slotEnd       DateTime
  otpHash       String
  otpExpiresAt  DateTime
  otpAttempts   Int          @default(0)
  feePaise      Int          @default(0) // money as integer paise (₹20 = 2000)
  completedAt   DateTime?
  completedById String?
  completedBy   User?        @relation("CompletedHandovers", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([parcelId])
  @@map("handovers")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcelId  String?
  parcel    Parcel?             @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  metadata  String?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([parcelId])
  @@map("notifications")
}

model OtpSession {
  id        String   @id @default(uuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_sessions")
}

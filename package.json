{
  "name": "parcelo",
  "version": "1.0.0",
  "private": true,
  "description": "Parcelo - Modern parcel-room management for Indian apartment societies",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build:shared && npm --workspace=apps/api run prisma:generate",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:shared": "npm --workspace=packages/shared run build",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace=apps/api run prisma:migrate",
    "db:seed": "npm --workspace=apps/api run prisma:seed",
    "db:studio": "npm --workspace=apps/api run prisma:studio"
  },
  "keywords": [
    "parcel-room",
    "apartment-society",
    "india",
    "fetch-package"
  ],
  "author": "Parcelo Engineering Team",
  "license": "ISC"
}

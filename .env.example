# Parcelo Environment Variables
PORT=4000
# development | test | production. Unset means production: no fixed OTP, secrets required.
NODE_ENV=development
# Proxy hops in front of the API (e.g. 1 behind nginx), so rate limits see real client IPs
TRUST_PROXY=0

# Database (docker compose exposes Postgres on host port 5433)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/thapal_dev?schema=public"

# Auth: a short access token, renewed from a refresh token that lasts REFRESH_TOKEN_DAYS
JWT_SECRET="parcelo_dev_super_secret_jwt_key_2026_indian_societies"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Door delivery fee in paise (2000 = ₹20); counter pickup is free
DOOR_DELIVERY_FEE_PAISE=2000

# Fixed login code in development only
DEFAULT_DEV_OTP="123456"

# Messages: console (prints them, development), whatsapp or sms. Production needs a real OTP_CHANNEL.
NOTIFY_CHANNEL=console
OTP_CHANNEL=console

# WhatsApp Cloud API (Meta). Templates take these variables in order:
#   OTP: code | NEW_PARCEL: courier, flat | REMINDER: courier, flat, days
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LANGUAGE=en
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_NEW_PARCEL=
WHATSAPP_TEMPLATE_REMINDER=

# MSG91 SMS (DLT-registered templates, same variables as above as var1, var2, var3)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_NEW_PARCEL=
MSG91_TEMPLATE_REMINDER=

# Background jobs (message sending, reminders, unclaimed parcels, clean-up)
JOBS_ENABLED=true
REMINDER_AFTER_DAYS=2
UNCLAIMED_AFTER_DAYS=7

# How long a parcel photo link stays valid
PHOTO_URL_TTL_MINUTES=60

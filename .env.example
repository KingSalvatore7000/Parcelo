# Thapal Environment Variables
PORT=4000
NODE_ENV=development

# Database (Postgres connection string for Docker container or local instance)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/thapal_dev?schema=public"

# Auth
JWT_SECRET="thapal_dev_super_secret_jwt_key_2026_indian_societies"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Mock OTP in dev
MOCK_SMS_CONSOLE=true
DEFAULT_DEV_OTP="123456"

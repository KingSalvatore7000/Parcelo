# Parcelo Environment Variables
PORT=4000
# development | test | production. Unset means production: no fixed OTP, secrets required.
NODE_ENV=development
# Proxy hops in front of the API (e.g. 1 behind nginx), so rate limits see real client IPs
TRUST_PROXY=0

# Database (docker compose exposes Postgres on host port 5433)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/thapal_dev?schema=public"

# Auth
JWT_SECRET="parcelo_dev_super_secret_jwt_key_2026_indian_societies"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Mock OTP in dev
MOCK_SMS_CONSOLE=true
DEFAULT_DEV_OTP="123456"
